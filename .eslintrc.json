{
	"root": true,
	"env": {
		"browser": true,
		"node": true,
		"es2021": true
	},
	"extends": [ "eslint:recommended" ],
	"parserOptions": {
		"ecmaVersion": 2021
	},
	"rules": {
		"semi": [ "error", "always" ],
		"quotes": [ "error", "single" ],
		"no-console": "warn",
		"max-lines-per-function": [ "error", 40 ],
		"complexity": [ "error", 6 ]
	}
}
